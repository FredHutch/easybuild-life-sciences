# easybuild easyconfig
#
# John Dey <jfdey@fredhutch.org>
#
# Fred Hutchinson Cancer Research Center - Seattle - US
easyblock = 'Bundle'

name = 'SQANTI3'
version = '5.4'

homepage = 'https://github.com/ConesaLab/SQANTI3'
description = """SQANTI3 is the first module of the Functional IsoTranscriptomics (FIT) framework,
 that also includes IsoAnnot and tappAS. Used for new long read-defined transcriptome."""

toolchain = {'name': 'foss', 'version': '2024a'}

builddependencies = [
    ('pkgconf', '1.5.5'),
    ('cURL', '7.66.0'),
]

dependencies = [
    ('Python', '3.12.3'), #  Python-3.12.3-GCCcore-13.3.0.eb
    ('SciPy-bundle', '2024.05'), #  SciPy-bundle-2024.05-gfbf-2024a.eb
    ('scikit-learn', '1.5.2'), #  scikit-learn-1.5.2-gfbf-2024a.eb
    ('Biopython', '1.84'), #  Biopython-1.84-foss-2024a.eb
    ('JupyterLab', '4.2.5'), #  JupyterLab-4.2.5-GCCcore-13.3.0.eb
    ('Pillow', '11.0.0'),
    ('Arrow', '17.0.0'),
    # missing toolchain for cDNA_Cupcake
    # missing toolchain for bx-python
    ('PyYAML', '6.0.2'), #  PyYAML-6.0.2-GCCcore-13.3.0.eb
    ('tqdm', '4.66.5'), #  tqdm-4.66.5-GCCcore-13.3.0.eb
    ('Pysam', '0.22.1'), #  Pysam-0.22.1-GCC-13.3.0.eb
    ('polars', '1.28.1'),
    ('BEDTools', '2.31.1'), #  BEDTools-2.31.1-GCC-13.3.0.eb
    ('SQLite', '3.45.3'), #  SQLite-3.45.3-GCCcore-13.3.0.eb
    # missing toolchain for gffread
    ('tbb', '2021.13.0'), #  tbb-2021.13.0-GCCcore-13.3.0.eb
    ('Tk', '8.6.14'), #  Tk-8.6.14-GCCcore-13.3.0.eb
    # missing toolchain for unixODBC
    ('XZ', '5.4.5'), #  XZ-5.4.5-GCCcore-13.3.0.eb
    ('ZeroMQ', '4.3.5'), #  ZeroMQ-4.3.5-GCCcore-13.3.0.eb
    ('zlib', '1.3.1'), #  zlib-1.3.1-GCCcore-13.3.0.eb
    ('zstd', '1.5.6'), #  zstd-1.5.6-GCCcore-13.3.0.eb

]

components = [
    (name, version, {
        'easyblock': 'Tarball',
        'source_urls': ['https://github.com/ConesaLab/SQANTI3/archive'],
        'sources': ['v%(version)s.tar.gz'],
        'checksums': [],
    })
]

local_gtf_url = 'http://hgdownload.cse.ucsc.edu/admin/exe/linux.x86_64/gtfToGenePred'
postinstallcmds = ['wget ' + local_gtf_url + ' -P %(installdir)s/%(name)s-%(version)s/utilities/']

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
    'use_pip': True,
}
exts_defaultclass = 'PythonPackage'
exts_list = [
    ('argh', '0.31.3'),
    ('dill', '0.4.0'),
    ('edlib', '1.3.9.post1'),
    ('packaging', '25.0', {
    }),
    ('pyfaidx', '0.8.1.4', {
    }),
    ('argcomplete', '3.6.2', {
    }),
    ('simplejson', '3.20.1', {
    }),
    ('gffutils', '0.13'),
    ('gtfparse', '2.5.0'),
    ('zipp', '3.22.0', {
    }),
    ('importlib-metadata', '8.7.0'),
    ('intervaltree', '3.1.0'),
    }),
    ('parasail', '1.3.4'),
    ('pdf2image', '1.17.0'),
    ('sortedcontainers', '2.4.0'),
    ('ultra-bioinformatics', '0.1'),
]

sanity_check_commands = ["python %(name)s-%(version)s/sqanti3_qc.py -h"]

modextrapaths = {
    'PATH': ['%(name)s-%(version)s', '%(name)s-%(version)s/utilities/'],
    'PYTHONPATH': ['%(name)s-%(version)s', 'lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'bio'
