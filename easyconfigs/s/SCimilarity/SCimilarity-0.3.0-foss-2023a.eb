easyblock = 'PythonBundle'

name = 'SCimilarity'
version = '0.3.0'

homepage = 'https://github.com/genentech/scimilarity'
description = """SCimilarity is a unifying representation of single cell expression profiles that 
quantifies similarity between expression states and generalizes to represent new studies without additional 
training."""

toolchain = {'name': 'foss', 'version': '2023a'}

dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),
    ('SciPy-bundle', '2023.07'),
    ('Arrow', '15.0.2'),
    ('zarr', '2.17.1'),
    ('scanpy', '1.9.8'),
    ('scikit-build', '0.17.6'),
    ('scikit-build-core', '0.5.0'),
    ('PyTorch-Lightning', '2.2.1'),
]

download_dep_fail = True
use_pip = True
sanity_pip_check = True

exts_list = [
    ('tiledb', '0.33.0', {
        'source_tmpl': 'tiledb-0.34.0-cp311-cp311-manylinux_2_28_x86_64.whl'
    }),
    ('captum', '0.7.0', {
    }),
    ('circlify', '0.15.0', {
    }),
    ('hnswlib', '0.8.0', {
    }),
    ('obonet', '1.1.0', {
    }),
    (name, version, {
        'modulename': '%(namelower)s',
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
        'source_tmpl': 'scimilarity-%(version)s.tar.gz',
    }),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages']
}

moduleclass = 'bio'
