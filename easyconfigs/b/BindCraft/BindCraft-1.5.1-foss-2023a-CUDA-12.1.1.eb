name = 'BindCraft'
version = '1.5.1'

homepage = "https://www.biorxiv.org/content/10.1101/2024.09.30.615802"
description = """Simple binder design pipeline using AlphaFold2 backpropagation, MPNN, and PyRosetta.
 Select your target and let the script do the rest of the work and finish once you have enough designs
 to order!"""

source_urls = ['https://github.com/martinpacesa/BindCraft/archive/refs/tags']
sources = ['v%(version)s.tar.gz']

dependancies = [
    ('Python', '3.11.3'), 
    ('CUDA', '12.1.1', '', SYSTEM),
    ('matplotlib', '3.7.2'),
    ('SciPy-bundle', '2023.07'),  # numpy"<2.0.0" 
    ('Biopython-1.83'),
    ('Seaborn', '0.13.2'),
    ##  GCC compiler flag libgfortran5
    ('tqdm', '4.66.1'),
    ('JupyterLab', '4.0.5),
    ('FFmpeg', '6.0'),
    ('PyRosetta-4.release-387-gompi-2023a.eb'),
    ('py3Dmol-2.1.0-GCCcore-12.3.0.eb'),  # out of date
    ('Flax', '0.8.4'),  # provides optax
    ('jax', '0.4.25'),
    ('cuDNN', '8.9.2.26', '-CUDA-12.1.1'),
    ('dm-haiku', '0.0.13'),
    ('dm-tree', '0.1.8'),
    ('ml-collections', '0.1.1'),
]

exts_list = [
    ('PDBFixer', '1.9', {
        'source_urls': ['https://github.com/openmm/pdbfixer/archive/'],
        'sources': [{'download_filename': '%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}],
        'checksums': ['88b9a77e50655f89d0eb2075093773e82c27a4cef842cb7d735c877b20cd39fb'],
    }),
    ('chex', '0.1.86', {
        'checksums': ['e8b0f96330eba4144659e1617c0f7a57b161e8cbb021e55c6d5056c7378091d1'],
    }),
    ('immutabledict', '4.1.0', {
        'checksums': ['93d100ccd2cd09a1fd3f136b9328c6e59529ba341de8bb499437f6819159fe8a'],
    }),
    ('fsspec', '2024.2.0', {
        'checksums': ['b6ad1a679f760dda52b1168c859d01b7b80648ea6f7f7c7f5a8a91dc3f3ecb84'],
