easyblock = 'PythonBundle'

name = 'fhTorch'
version = '2.13.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://pytorch.org/'
description = """Tensors and Dynamic neural networks in Python with strong GPU acceleration.
PyTorch is a deep learning framework that puts Python first."""

toolchain = {'name': 'foss', 'version': '2026.1'}

dependencies = [
    ('Python', '3.14.2'),
    ('CUDA', '13.2.0', '', SYSTEM),
    ('SciPy-bundle', '2026.05'),
    # ('Python-bundle-PyPI', '2025.04'), from SciPy
    ('sympy', '1.14.0'),
    ('networkx', '3.6.1'),
    ('PyYAML', '6.0.3'),
]

sanity_pip_check = False

""" Install Torch direct from wheel downloaded from PyTorch.org. https://download.pytorch.org/whl/cu132/torch/
  The torch module pulls in a huge number of nvidia and cuda packages, from PyPi and pytorch.org.
  It does not help to add the CUDA module, it will be ignored and the speicif version ov CUDA and 
  Nvidia tools will be downloaded as wheels.

  from EBcb container load this module then run pip install. It will install into /app/software/fhTorch/
  Torch Wheel files are here: /app/sources/t/torch 

  ml fhTorch/2.13.0 
  PYTHONPATH=$PYTHONPAH pip install torch-2.13.0+cu132-cp314-cp314-manylinux_2_28_x86_64.whl \
    --target=/app/software/fhTorch/2.13.0-foss-2026.1-CUDA-13.2.0/lib/python3.14/site-packages

...
